@startuml
title Diagramme de classes - AttendFlow

skinparam classAttributeIconSize 0
skinparam linetype polyline
hide empty methods

' ===== ENUMERATIONS =====

enum Mascotte {
  PLUME
  TIC
  POUSSE
  BULLE
  FILOU
  COMETE
}

enum Role {
  ADMIN
  ENSEIGNANT
  ETUDIANT
}

enum EtatSeance {
  PLANIFIEE
  MODIFIEE
  ANNULEE
}

enum StatutPresence {
  PRESENT
  ABSENT
  RETARD
  JUSTIFIE
}

enum EtatJustificatif {
  EN_ATTENTE
  ACCEPTE
  REFUSE
}

enum TypeNotification {
  INFORMATION
  AVERTISSEMENT
  SUCCES
}

enum StatutSynchronisation {
  SUCCES
  PARTIEL
  ECHEC
}

' ===== CLASSES =====

class Utilisateur {
  - id : Long
  - nom : String
  - prenom : String
  - email : String {unique}
  - telephone : String
  - motDePasse : String
  - role : Role
  - mascotte : Mascotte [0..1]
}

class Admin

class Enseignant {
  - specialite : String
}

class Etudiant {
  - matricule : String {unique}
  - dateNaissance : Date
  - photo : String
}

class Classe {
  - id : Long
  - nom : String
  - niveau : String
  - responsable : String
  - anneeUniversitaire : String
  - /effectif : Integer
}

class Matiere {
  - id : Long
  - intitule : String
  - code : String {unique}
  - coefficient : Double
}

class Salle {
  - id : Long
  - nom : String {unique}
  - capacite : Integer
}

class Seance {
  - id : Long
  - idExterne : String {unique}
  - date : Date
  - heureDebut : Time
  - heureFin : Time
  - etat : EtatSeance
  - dateSynchro : DateTime
}

class Presence {
  - id : Long
  - statut : StatutPresence
  - commentaire : String
  - dateSaisie : DateTime
}

class HistoriqueModification {
  - id : Long
  - dateModification : DateTime
  - ancienStatut : StatutPresence
  - nouveauStatut : StatutPresence
}

class Justificatif {
  - id : Long
  - fichier : String
  - motif : String
  - etat : EtatJustificatif
  - dateDepot : DateTime
  - dateTraitement : DateTime
}

class Notification {
  - id : Long
  - type : TypeNotification
  - titre : String
  - message : String
  - lue : Boolean
  - date : DateTime
}

class Parametre {
  - id : Long
  - seuilAbsence : Double
  - nbMaxAbsencesNonJustifiees : Integer
  - delaiModificationHeures : Integer
  - retardCommePresent : Boolean
  - justifieCommePresent : Boolean
}

class JournalSynchronisation {
  - id : Long
  - dateSynchro : DateTime
  - nbAjoutees : Integer
  - nbModifiees : Integer
  - nbAnnulees : Integer
  - statut : StatutSynchronisation
  - message : String
}

class TokenReinitialisation {
  - id : Long
  - token : String {unique}
  - dateExpiration : DateTime
  - utilise : Boolean
}

' ===== HERITAGE =====

Utilisateur <|-- Etudiant
Utilisateur <|-- Enseignant
Utilisateur <|-- Admin

' ===== RELATIONS =====

Enseignant "0..*" -- "1..*" Matiere : enseigne

Classe "1" -- "0..*" Etudiant : contient

Classe "1" -- "0..*" Seance : planifie

Matiere "1" -- "0..*" Seance : concerne

Salle "1" -- "0..*" Seance : accueille

Enseignant "1" -- "0..*" Seance : assure

Seance "1" *-- "0..*" Presence : genere

Etudiant "1" -- "0..*" Presence : possede

Presence "1" *-- "0..*" HistoriqueModification : trace

Utilisateur "1" -- "0..*" HistoriqueModification : auteur

Presence "1" -- "0..1" Justificatif : justifie par

Admin "0..1" -- "0..*" Justificatif : traite

Utilisateur "1" -- "0..*" Notification : recoit

Admin "0..1" -- "0..1" Parametre : modifie

Admin "0..1" -- "0..*" JournalSynchronisation : declenche

Utilisateur "1" -- "0..*" TokenReinitialisation : demande

' ===== NOTES =====

note bottom of Etudiant
  RG-07 : un etudiant appartient a une seule
  classe par annee universitaire.
end note

note bottom of Seance
  RG-09 : les seances sont fournies par le projet
  partenaire. AttendFlow les consomme en lecture seule.
end note

note right of Presence
  RG-02 : un seul statut par etudiant
  et par seance (seance, etudiant) unique.
end note

note bottom of Parametre
  Une seule ligne en base. modifie = dernier
  administrateur ayant change les parametres.
end note

note bottom of JournalSynchronisation
  F-12 : synchronisation periodique
  (declencheur null) ou a la demande (Admin).
end note

@enduml
